{
  "name": "dramaclaw-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal Electron shell for DramaClaw CE — spawns the local backend and serves the built web frontend from a single origin.",
  "license": "Elastic-2.0",
  "main": "main.js",
  "scripts": {
    "build:frontend": "pnpm -C ../frontend build",
    "start": "electron .",
    "dev": "pnpm run build:frontend && electron .",
    "dev:vite": "cross-env DRAMACLAW_DEV_URL=http://localhost:5173 electron ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1"
  }
}
