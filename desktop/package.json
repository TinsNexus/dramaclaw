{
  "name": "dramaclaw-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal Electron shell for DramaClaw CE — spawns the local backend and serves the built web frontend from a single origin.",
  "license": "Elastic-2.0",
  "main": "main.js",
  "scripts": {
    "build:frontend": "pnpm -C ../frontend build",
    "bundle:backend": "bash scripts/bundle-backend.sh",
    "start": "electron .",
    "dev": "pnpm run build:frontend && electron .",
    "dev:vite": "cross-env DRAMACLAW_DEV_URL=http://localhost:5173 electron .",
    "prep": "pnpm run build:frontend && pnpm run bundle:backend",
    "dist:mac": "pnpm run prep && electron-builder --mac --arm64",
    "dist:win": "pnpm run prep && electron-builder --win --x64",
    "dist:dir": "pnpm run prep && electron-builder --dir"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.dramaclaw.desktop",
    "productName": "DramaClaw",
    "asar": true,
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "resources/pybackend",
        "to": "pybackend"
      },
      {
        "from": "../frontend/dist",
        "to": "dist"
      }
    ],
    "directories": {
      "output": "dist-installers"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
