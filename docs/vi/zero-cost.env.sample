# =============================================================================
# Mẫu override cho chế độ ít tốn tiền — chép các dòng cần dùng vào .env
# Giải thích đầy đủ: docs/vi/zero-cost-setup.md
# File này KHÔNG chứa secret. Đừng đặt key thật vào đây.
# =============================================================================

# --- Lồng tiếng: Edge TTS, miễn phí, không cần key -------------------------
TTS_PROVIDER=edge
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural      # giọng nam: vi-VN-NamMinhNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# --- Video: ComfyUI chạy local, miễn phí nếu có GPU ------------------------
# Bỏ comment khi ComfyUI đã chạy ở máy bạn.
# BẮT BUỘC khai báo địa chỉ: mặc định trong code trỏ ra GPU thuê của nhóm dev.
# VIDEO_BACKEND=comfyui
# COMFYUI_ADDRESS=127.0.0.1:8188
# COMFYUI_VIDEO_URL=http://127.0.0.1:8188
# COMFYUI_USE_SSL=false
# COMFYUI_WORKFLOW=gguf                # gguf ~8GB VRAM | fp8 ~16GB VRAM

# --- Không có đường miễn phí cho sinh ảnh ----------------------------------
# CHARACTER_IMAGE_MODEL / NANOBANANA_PROVIDER / NEWAPI_IMAGE_MODEL đều tính tiền.
# Muốn né: sinh ảnh ở ComfyUI riêng rồi upload qua trang nhân vật hoặc Freezone.

# --- Phần chữ ---------------------------------------------------------------
# Các biến *_MODEL (SCENE_BUILD_MODEL, EPISODE_SCENE_PLANNER_MODEL,
# IDENTITY_PLANNER_*, CONTENT_REWRITER_MODEL, ...) đều gọi model tính tiền.
# Rẻ nhất: để Claude viết kịch bản/phân cảnh ngoài pipeline rồi nạp vào project.
